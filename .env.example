# 在本机复制为 .env，填写后保存。不要提交 .env。Base URL 填到 /v1。
# 当前支持 OpenAI 兼容接口，认证使用 Bearer API Key；密钥本身不带 Bearer 前缀。
# 对话服务：负责需求规划和结果审核。
AFL_CHAT_BASE_URL=
AFL_CHAT_MODEL=
AFL_CHAT_API_KEY=
# Embedding 服务：负责生成向量，必须填供应商支持的向量模型，不能直接照抄对话模型名。
AFL_EMBEDDING_BASE_URL=
AFL_EMBEDDING_MODEL=
AFL_EMBEDDING_API_KEY=
# 每次模型请求的超时秒数；不会自动重试供应商请求。
AFL_MODEL_TIMEOUT_SECONDS=45
AFL_PORT=19090
